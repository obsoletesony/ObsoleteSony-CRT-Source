---
import BooksLayout from "../layouts/BooksLayout.astro";
import { watchNavigation } from "../data/watch-navigation";
import "../styles/watch.css";

/*
 * The TV is the full-viewport hero. These are the two supplied art layers:
 * frame: alpha-transparent screen opening; glass: screen-off appearance.
 * Both files must be published together at /images/watch/.
 *
 * The versioned local CRT runtime supplies processed frames and audio.
 * These art/OSD layers remain separate from the exported recording.
 */
---

<BooksLayout
  title="ObsoleteSony CRT | A VHS Video Experiment"
  description="Drop a video into a vintage Sony Trinitron. A free browser-based ObsoleteSony experiment inspired by the look of VHS."
  indexable={false}
  bodyClass="watch-theme"
  themeColor="#0b0b0b"
  sectionNavigation={watchNavigation}
  showSectionAnnouncement={false}
>
  <main class="watch-main">
  <section class="watch-page" data-watch-app data-state="off" data-assets-ready="false" aria-labelledby="watch-title">
    <div class="watch-stage" id="watch-stage">
      <div class="watch-art-loader" role="status" aria-live="polite">
        <span class="watch-art-spinner" aria-hidden="true"></span>
        <span class="watch-art-error" data-watch-art-error hidden>Unable to load the television. Reload the page.</span>
        <span class="watch-screenreader-only" data-watch-art-loading>Loading television graphics.</span>
      </div>
      <div class="watch-tv" id="watch-tv" role="group" aria-label="Sony Trinitron television video player">
        <img
          class="watch-tv__glass"
          src="/images/watch/tv-glass-v2.webp"
          width="2048"
          height="1524"
          alt=""
          aria-hidden="true"
          decoding="async"
        />

        <div class="watch-tv__screen" id="watch-screen">
          <!-- A strict 4:3 picture window. Widescreen/portrait sources are
               center-cropped, not letterboxed or stretched. The bezel masks
               the screen's slight physical curvature separately. -->
          <div class="watch-tv__picture" id="watch-picture">
            <canvas
              class="watch-tv__video"
              id="watch-video"
              width="640"
              height="480"
              aria-label="Center-cropped 4:3 video preview in the Sony CRT"
            ></canvas>
          </div>
          <div class="watch-tv__scanlines" aria-hidden="true"></div>
          <div class="watch-captions" data-watch-captions aria-hidden="true"></div>

          <div class="watch-osd">
            <div class="watch-osd__message" data-watch-osd>DROP VIDEO</div>
            <div class="watch-osd__submessage" data-watch-subosd>OR CLICK TO SELECT</div>
            <button type="button" class="watch-osd__action" data-watch-cancel hidden>CANCEL</button>
            <div class="watch-osd__progress" data-watch-progress hidden>
              <div class="watch-osd__segments" data-watch-segments></div>
            </div>
          </div>
          <button
            class="watch-tv__screen-action"
            id="watch-screen-action"
            type="button"
            aria-label="Choose a video file to play on the television"
          ></button>
        </div>

        <img
          class="watch-tv__cabinet"
          src="/images/watch/tv-frame-v2.webp"
          width="2047"
          height="1901"
          alt="1990s Sony Trinitron television"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>

    <div class="watch-transport" data-watch-transport aria-label="Video playback controls">
      <div class="watch-transport__seek">
        <input id="watch-seek" type="range" min="0" max="1000" step="1" value="0"
          aria-label="Seek through video" disabled />
      </div>
      <div class="watch-transport__row">
        <button class="watch-transport__button watch-transport__play" type="button"
          data-watch-play data-playing="false" aria-label="Play" title="Play" disabled>
          <svg class="watch-transport__icon watch-transport__icon--play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M8 5.5v13l10-6.5z" />
          </svg>
          <svg class="watch-transport__icon watch-transport__icon--pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <rect x="6" y="5" width="4" height="14" rx="1" />
            <rect x="14" y="5" width="4" height="14" rx="1" />
          </svg>
        </button>
        <span class="watch-transport__time" data-watch-time>0:00 / 0:00</span>
        <button class="watch-transport__button watch-transport__mute" type="button"
          data-watch-mute aria-label="Mute audio" title="Mute or unmute" disabled>VOL</button>
        <input class="watch-transport__volume" data-watch-volume type="range" min="0" max="100" step="1" value="100"
          aria-label="Playback volume" disabled />
        <span class="watch-transport__spacer"></span>
        <button class="watch-transport__button" type="button" data-watch-caption-toggle
          aria-label="Load subtitles" title="Load an SRT or VTT subtitle file" disabled>CC</button>
        <select class="watch-transport__captions-select" data-watch-caption-track
          aria-label="Subtitle track" title="Select embedded or external subtitles" hidden></select>
        <button class="watch-transport__button" type="button" data-watch-fullscreen
          aria-label="Enter fullscreen" title="Fullscreen" disabled>⛶</button>
        <button class="watch-transport__button watch-transport__save" type="button"
          data-watch-save aria-label="Download processed video" title="Download processed video" disabled>
          <svg class="watch-transport__icon" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M12 3v12m-5-5 5 5 5-5" />
            <path d="M5 17v3h14v-3" />
          </svg>
        </button>
      </div>
      <input class="watch-file-input" type="file" id="watch-captions-file" accept=".srt,.vtt,text/vtt"
        aria-label="Choose an SRT or VTT subtitle file" tabindex="-1" />
    </div>

    <h1 id="watch-title" class="watch-screenreader-only">ObsoleteSony CRT</h1>
    <p class="watch-screenreader-only" id="watch-status" role="status" aria-live="polite">
      Drop a video onto the television or click the screen to choose a file.
    </p>

    <input
      class="watch-file-input"
      id="watch-file"
      type="file"
      accept="video/*,.mp4,.mov,.m4v,.webm,.mkv,.ogv"
      aria-label="Select a local video"
      tabindex="-1"
    />
  </section>
  </main>
</BooksLayout>

<script>
  import "../scripts/watch.ts";
</script>
