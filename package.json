  "scripts": {
    "build-aac-codec": "docker build -t ntsc_rs_web_aac ./aac-codec && docker run --rm -v ./aac-codec:/src -u $(id -u):$(id -g) -it ntsc_rs_web_aac /bin/bash -c 'cd /src && ./configure_wasm.sh && ./build.sh'",
    "build:crt": "node scripts/generate-profiles.mjs && vite build --config vite.crt.config.ts && node scripts/package-crt.mjs",
    "check:crt": "tsc -p tsconfig.crt.json",
    "test:crt": "node --test tests/contracts.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@preact/signals": "^2.5.1",
    "clsx": "^2.1.1",
    "mediabunny": "^1.27.2",
    "preact": "^10.22.1",
    "valadaptive-lib": "file:./valadaptive-lib",
    "wasm-feature-detect": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.9.3",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^26.1.1",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "eslint": "^10.7.0",
    "playwright": "1.60.0",
    "sass-embedded": "^1.83.0",
    "sonda": "^0.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.8.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.2.0"
  },
  "name": "@obsoletesony/crt",
  "version": "1.0.0"
}
